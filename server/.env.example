# Copy to server/.env to override defaults. All values are optional in development.

# Port the API listens on (the web dev server proxies /api here).
PORT=3001

# SQLite database file. Defaults to server/data/eventease.db.
# DB_PATH=./data/eventease.db

# "dev" = development sign-in (pick a sample account). "sso" = real university SSO (not wired yet).
# Defaults to "dev" locally and "sso" when NODE_ENV=production; the server refuses dev sign-in in production.
AUTH_MODE=dev

# Secret for signing QR pass tokens. REQUIRED in production: use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# PASS_SECRET=

# Session lifetime in hours (default 168 = 7 days).
# SESSION_TTL_HOURS=168

# Origins allowed to make state-changing requests (CSRF protection), comma-separated.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Public address of the web app, used for links in emails and in calendar feed URLs.
# APP_URL=http://localhost:5173

# How each channel delivers. "console" prints each message in the API's terminal (development);
# "none" turns it off (email and push stay queued in the outbox). Real providers plug into src/lib/channels.ts.
# MAIL_MODE=console
# PUSH_MODE=console
# SMS and WhatsApp need university approval, so they are off unless switched on:
# SMS_MODE=none
# WHATSAPP_MODE=none

# Web Push VAPID key pair (base64url). REQUIRED in production. Development derives a stable pair from PASS_SECRET.
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Payments. Only the built-in "mock" gateway exists so far, and the server refuses it in production.
# PAYMENT_GATEWAY=mock
# Secret the gateway signs webhooks with. REQUIRED in production.
# PAYMENT_WEBHOOK_SECRET=
# How long a seat is held while the student pays, in minutes.
# PAYMENT_WINDOW_MINUTES=30

# Where uploaded registration documents are stored. Defaults to server/data/uploads.
# UPLOADS_DIR=./data/uploads

# How often scheduled work runs (reminders, attendance, expiries, delivery), in seconds. 0 turns it off.
# SCHEDULER_INTERVAL_SECONDS=60
